**/Debug/
**/client/scripts/
**/source/tmp/

# Build output directories
**/source/out/
**/source/build-linux/
**/source/bin/

# Library files (ignore by default, but allow specific paths)
*.lib
*.dll
# Allow x64 libraries to be tracked
!**/source/lib/x64/**/*.lib
!**/source/bin/x64/**/*.dll
# Allow BugTrap crash-reporter binaries (needed to build/link)
!**/third_party/BugTrap/bin/*.dll
!**/third_party/BugTrap/lib/*.lib
!**/source/lib/Release/BugTrap*.lib
!**/source/lib/Debug/BugTrap*.lib

# RmlUi / FreeType: allow source trees and client static libs under 100MB.
# Debug rmlui.lib is ~100MB+ and exceeds GitHub's file limit — build it locally:
#   .\tools\build-rmlui.ps1 -Config Debug
# (**/Debug/ above would otherwise block source/lib/Debug entirely)
!**/source/lib/Debug/
!**/source/lib/Debug/rmlui_debugger.lib
!**/source/lib/Debug/freetyped.lib
!**/source/lib/Release/rmlui.lib
!**/source/lib/Release/rmlui_debugger.lib
!**/source/lib/Release/freetype.lib

# Allow third-party RmlUi + FreeType sources (keep their CMake build dirs ignored)
!**/third_party/RmlUi/
!**/third_party/RmlUi/**
!**/third_party/freetype/
!**/third_party/freetype/**
**/third_party/freetype/build/
**/third_party/RmlUi/build/
# Re-allow common file types ignored globally when under these trees
!**/third_party/RmlUi/**/*.json
!**/third_party/RmlUi/**/*.htm
!**/third_party/RmlUi/**/*.html
!**/third_party/RmlUi/**/*.cfg
!**/third_party/freetype/**/*.json
!**/third_party/freetype/**/*.htm
!**/third_party/freetype/**/*.html
!**/third_party/freetype/**/*.cfg

# Allow source-libs (third-party library sources)
!**/source-libs/

# Build output logs
build_errors.txt
build_log.txt
build_result.txt

# Loose root scripts (consolidated into source/scripts/)
/build.sh
/build_safe.sh
/fixlong.sh
/start_pko.sh
/start_servers.sh
/check_logs.sh
/check_db.sh

# Backup/temp files
*.orig
*.bak
*.tmp
*~

# Client runtime logs
**/client/log/
**/client/log1/
**/client/calua_err.txt
**/client/lua_err.txt
**/client/exception.txt