/* Buttons — primary / secondary / danger / ghost */

.ui-btn,
button.ui-btn {
	display: block;
	box-sizing: border-box;
	height: 38dp;
	padding: 0dp 16dp;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	border-width: 1dp;
	transition: background-color 0.15s, border-color 0.15s, color 0.15s;
}

.ui-btn-block { width: 100%; }

.ui-btn-row {
	display: block;
	width: 100%;
	height: 38dp;
}

.ui-btn-row .ui-btn {
	display: inline-block;
	vertical-align: top;
	width: auto;
	min-width: 120dp;
	margin-right: 8dp;
}

.ui-btn-row .ui-btn:last-child {
	margin-right: 0dp;
}

/* Primary — cyan magic fill */
.ui-btn-primary,
button.ui-btn-primary {
	color: #041016;
	background-color: #3ec9d8;
	border-color: #7aebf5;
}

.ui-btn-primary:hover,
button.ui-btn-primary:hover {
	background-color: #5eddea;
	border-color: #b6f4fc;
}

.ui-btn-primary:active,
button.ui-btn-primary:active {
	background-color: #2aafbd;
	border-color: #3ec9d8;
}

/* Secondary — metal glass */
.ui-btn-secondary,
button.ui-btn-secondary {
	color: #e6f0f5;
	background-color: #152430;
	border-color: #3a5a66;
}

.ui-btn-secondary:hover,
button.ui-btn-secondary:hover {
	background-color: #1e3442;
	border-color: #5a8a96;
	color: #f3fbff;
}

.ui-btn-secondary:active,
button.ui-btn-secondary:active {
	background-color: #101c26;
}

/* Danger */
.ui-btn-danger,
button.ui-btn-danger {
	color: #ffe8e8;
	background-color: #3a1818;
	border-color: #d45a5a;
}

.ui-btn-danger:hover,
button.ui-btn-danger:hover {
	background-color: #4a2020;
	border-color: #f07a7a;
}

/* Ghost / quiet */
.ui-btn-ghost,
button.ui-btn-ghost {
	color: #8da3b0;
	background-color: #101820;
	border-color: #2a4048;
}

.ui-btn-ghost:hover,
button.ui-btn-ghost:hover {
	color: #e6f0f5;
	background-color: #182430;
	border-color: #3d5a64;
}

/* Disabled */
.ui-btn:disabled,
button.ui-btn:disabled,
.ui-btn-disabled {
	color: #5f7380;
	background-color: #151a1e;
	border-color: #2a3338;
}
