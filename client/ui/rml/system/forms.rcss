/* Form controls — text, password, checkbox, radio, select */

.ui-field {
	display: block;
	width: 100%;
	margin-bottom: 14dp;
}

.ui-label {
	display: block;
	width: 100%;
	margin-bottom: 6dp;
	font-size: 12dp;
	color: #8da3b0;
}

.ui-input,
input.ui-input,
input[type="text"].ui-input,
input[type="password"].ui-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	padding: 0dp 12dp;
	font-family: LatoLatin;
	font-size: 14dp;
	color: #e6f0f5;
	background-color: #060b10;
	border-width: 1dp;
	border-color: #2a4450;
	transition: border-color 0.15s, background-color 0.15s;
}

.ui-input:focus,
input.ui-input:focus,
input[type="text"].ui-input:focus,
input[type="password"].ui-input:focus {
	border-color: #3ec9d8;
	background-color: #0c1822;
}

.ui-input:disabled,
input.ui-input:disabled {
	color: #5f7380;
	background-color: #151a1e;
	border-color: #2a3338;
}

/* Checkbox / radio row */
.ui-check-row,
.ui-radio-row {
	display: block;
	width: 100%;
	height: 22dp;
	margin: 2dp 0dp 14dp 0dp;
}

.ui-check,
input[type="checkbox"].ui-check,
.ui-radio,
input[type="radio"].ui-radio {
	display: inline-block;
	vertical-align: middle;
	width: 16dp;
	height: 16dp;
	margin: 0dp 10dp 0dp 0dp;
	padding: 0dp;
	background-color: #060b10;
	border-width: 1dp;
	border-color: #3a7f8c;
	transition: background-color 0.12s, border-color 0.12s;
}

.ui-check:checked,
input[type="checkbox"].ui-check:checked,
.ui-radio:checked,
input[type="radio"].ui-radio:checked {
	background-color: #2a9eac;
	border-color: #7aebf5;
}

.ui-check-row > label,
.ui-radio-row > label {
	display: inline-block;
	vertical-align: middle;
	width: auto;
	color: #a9c2cd;
	font-size: 13dp;
}

/* Select / dropdown */
.ui-select,
select.ui-select {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	padding: 0dp 12dp;
	font-family: LatoLatin;
	font-size: 14dp;
	color: #e6f0f5;
	background-color: #060b10;
	border-width: 1dp;
	border-color: #2a4450;
}

.ui-select:focus,
select.ui-select:focus {
	border-color: #3ec9d8;
}

/* Textarea */
.ui-textarea,
textarea.ui-textarea {
	display: block;
	box-sizing: border-box;
	width: 100%;
	min-height: 88dp;
	padding: 10dp 12dp;
	font-family: LatoLatin;
	font-size: 13dp;
	color: #e6f0f5;
	background-color: #060b10;
	border-width: 1dp;
	border-color: #2a4450;
}
