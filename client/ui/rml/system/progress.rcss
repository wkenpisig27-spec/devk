/* Progress bars + scrollbars */

.ui-progress {
	display: block;
	width: 100%;
	height: 12dp;
	padding: 2dp;
	background-color: #070d12;
	border-width: 1dp;
	border-color: #2a4450;
	margin: 6dp 0dp;
}

.ui-progress-fill {
	display: block;
	height: 100%;
	width: 40%;
	background-color: #3ec9d8;
}

.ui-progress-hp .ui-progress-fill { background-color: #d45a5a; }
.ui-progress-mp .ui-progress-fill { background-color: #4a8dff; }
.ui-progress-exp .ui-progress-fill { background-color: #efb04a; }

.ui-progress-label {
	display: block;
	font-size: 11dp;
	color: #8da3b0;
	margin-bottom: 2dp;
}

/* Scrollable region */
.ui-scroll {
	display: block;
	width: 100%;
	overflow: auto;
	background-color: #070d12;
	border-width: 1dp;
	border-color: #1e4a54;
}

/* Custom scrollbar (RmlUi scrollbar-* properties) */
.ui-scroll scrollbar-vertical {
	width: 10dp;
	margin-left: 2dp;
}

.ui-scroll scrollbar-vertical slidertrack {
	background-color: #0a1016;
	border-width: 1dp;
	border-color: #2a4450;
}

.ui-scroll scrollbar-vertical sliderbar {
	background-color: #2a5f6a;
	border-width: 1dp;
	border-color: #3ec9d8;
}

.ui-scroll scrollbar-vertical sliderbar:hover {
	background-color: #3ec9d8;
}
