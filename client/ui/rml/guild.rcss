/* Notice Guild Interface — in-game manager (Members / Apply / Vault / Logs). */

body.guild-body {
	position: relative;
	width: 100%;
	height: 100%;
	justify-content: flex-start;
	align-items: flex-start;
	padding: 0dp;
	pointer-events: none;
	font-family: LatoLatin;
}

body.guild-body .guild-root,
body.guild-body .guild-perm-modal-open,
body.guild-body .guild-motto-modal-open,
body.guild-body .guild-perm-scrim-open {
	pointer-events: auto;
}

.guild-root {
	display: none;
	position: absolute;
	flex-direction: column;
	flex: none;
	box-sizing: border-box;
	width: 455dp;
	min-width: 455dp;
	height: 373dp;
	margin: 0dp;
	padding: 0dp 0dp 6dp 0dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
}

.guild-root-open {
	display: flex;
}

.guild-header {
	display: block;
	position: relative;
	z-index: 2;
	box-sizing: border-box;
	height: 56dp;
	padding: 0dp 16dp;
	background-color: transparent;
}

.guild-drag {
	display: block;
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	z-index: 1;
	padding: 0dp 16dp;
	box-sizing: border-box;
	cursor: move;
}

.guild-title {
	display: block;
	padding-top: 16dp;
	font-size: 15dp;
	font-weight: bold;
	color: #ffffff;
	text-align: left;
}

.guild-close,
button.guild-close {
	display: block;
	position: absolute;
	right: 12dp;
	top: 14dp;
	z-index: 3;
	width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.guild-main {
	display: flex;
	flex-direction: row;
	flex: 1;
	box-sizing: border-box;
	padding: 2dp 10dp 0dp 10dp;
	overflow: visible;
}

.guild-side {
	display: flex;
	flex-direction: column;
	flex: none;
	width: 148dp;
	min-width: 148dp;
	margin-right: 6dp;
}

.guild-info {
	display: block;
	flex: none;
	box-sizing: border-box;
	width: 148dp;
	min-height: 190dp;
	padding: 4dp 8dp 6dp 8dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.guild-info-title {
	display: block;
	height: 16dp;
	line-height: 16dp;
	margin-bottom: 2dp;
	font-size: 11dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: center;
}

.guild-field {
	display: block;
	margin-bottom: 2dp;
	pointer-events: none;
}

.guild-field-last {
	margin-bottom: 0dp;
}

.guild-field-label {
	display: block;
	font-size: 10dp;
	font-weight: bold;
	color: #5a7ab0;
	line-height: 12dp;
}

.guild-field-value {
	display: block;
	min-height: 13dp;
	font-size: 11dp;
	font-weight: bold;
	color: #2a4a80;
	line-height: 13dp;
}

.guild-actions {
	display: block;
	flex: none;
	margin-top: 6dp;
	width: 148dp;
}

.guild-action-row {
	display: flex;
	flex-direction: row;
	width: 148dp;
	height: 28dp;
	margin-bottom: 4dp;
}

.guild-action,
button.guild-action {
	display: block;
	flex: none;
	width: 71dp;
	height: 28dp;
	line-height: 28dp;
	margin: 0dp 6dp 0dp 0dp;
	font-size: 11dp;
}

.guild-action-end,
button.guild-action-end {
	margin-right: 0dp;
}

.notice-btn.notice-btn-disabled,
button.notice-btn.notice-btn-disabled,
.notice-btn.notice-btn-disabled:hover,
button.notice-btn.notice-btn-disabled:hover {
	image-color: #6a90c0;
	color: #c8d8ec;
}

.guild-content {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-width: 0dp;
	overflow: visible;
}

.guild-tabs {
	display: flex;
	flex-direction: row;
	flex: none;
	height: 24dp;
	padding: 0dp 4dp;
}

.guild-tab,
button.guild-tab {
	display: block;
	flex: none;
	width: 62dp;
	height: 24dp;
	line-height: 24dp;
	margin-right: 2dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 11dp;
	font-weight: bold;
	text-align: center;
	color: #5a7ab0;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.guild-tab-active,
button.guild-tab-active {
	color: #2a4a80;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.guild-page {
	display: flex;
	flex-direction: column;
	flex: 1;
	box-sizing: border-box;
	padding: 4dp 6dp 4dp 6dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.guild-page-hidden {
	display: none;
}

.guild-table {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.guild-thead {
	display: flex;
	flex-direction: row;
	flex: none;
	height: 20dp;
	border-bottom: 1dp #9eb8e8;
}

.guild-th,
button.guild-th {
	display: block;
	height: 20dp;
	line-height: 20dp;
	padding: 0dp 4dp;
	font-family: LatoLatin;
	font-size: 11dp;
	font-weight: bold;
	text-align: left;
	color: #5a7ab0;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.guild-th-name { width: 100dp; }
.guild-th-class { width: 96dp; }
.guild-th-level { flex: 1; }

.guild-tbody {
	display: block;
	flex: 1;
	overflow: auto;
}

.guild-row,
button.guild-row {
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	width: 100%;
	height: 20dp;
	margin: 0dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 11dp;
	font-weight: bold;
	text-align: left;
	color: #2a4a80;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 1dp;
	border-left-width: 0dp;
	border-bottom: 1dp #c8daf0;
	border-radius: 0dp;
}

.guild-row:hover,
button.guild-row:hover {
	background-color: #e8f0fa;
}

.guild-row-sel,
button.guild-row-sel,
.guild-row-sel:hover,
button.guild-row-sel:hover {
	background-color: #d4e4f8;
	color: #1a3a70;
}

.guild-row-offline {
	color: #7a8aa8;
}

.guild-cell {
	display: block;
	height: 20dp;
	line-height: 20dp;
	padding: 0dp 4dp;
	overflow: hidden;
	pointer-events: none;
}

.guild-cell-name { width: 100dp; }
.guild-cell-class { width: 96dp; }
.guild-cell-level { flex: 1; }

.guild-vault-gold {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: none;
	height: 28dp;
	margin-bottom: 4dp;
}

.guild-vault-gold-label {
	display: block;
	font-size: 10dp;
	font-weight: bold;
	color: #5a7ab0;
	margin-right: 6dp;
}

.guild-vault-gold-value {
	display: block;
	flex: 1;
	font-size: 12dp;
	font-weight: bold;
	color: #2a4a80;
}

.guild-vault-btn,
button.guild-vault-btn {
	flex: none;
	width: 56dp;
	height: 26dp;
	line-height: 26dp;
	margin: 0dp 0dp 0dp 4dp;
	font-size: 11dp;
}

.guild-vault-body {
	display: flex;
	flex-direction: row;
	position: relative;
	flex: 1;
	overflow: hidden;
}

.guild-vault-grid {
	display: block;
	flex: 1;
	overflow: hidden;
	clip: always;
}

.guild-vault-scrollbar {
	display: block;
	position: relative;
	flex: none;
	width: 10dp;
	margin-left: 6dp;
	overflow: visible;
	decorator: tiled-vertical(
		ui/rml/frames/notice/scroll_track_t.tga,
		ui/rml/frames/notice/scroll_track_c.tga,
		ui/rml/frames/notice/scroll_track_b.tga
	);
}

.guild-vault-scroll-thumb {
	display: none;
	position: absolute;
	left: 0dp;
	width: 10dp;
	height: 40dp;
	decorator: tiled-vertical(
		ui/rml/frames/notice/scroll_thumb_t.tga,
		ui/rml/frames/notice/scroll_thumb_c.tga,
		ui/rml/frames/notice/scroll_thumb_b.tga
	);
}

.guild-vault-locked {
	display: none;
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	padding-top: 80dp;
	font-size: 14dp;
	font-weight: bold;
	color: #5a7ab0;
	text-align: center;
	background-color: #f5f9ffe8;
}

.guild-vault-locked-on {
	display: block;
}

.guild-slot {
	display: block;
	position: relative;
	box-sizing: border-box;
	flex: none;
	width: 44dp;
	height: 44dp;
	padding: 4dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: image(ui/rml/frames/notice/slot_rounded.tga);
	drag: none;
	focus: none;
	pointer-events: auto;
}

.guild-slot-icon {
	display: block;
	width: 36dp;
	height: 36dp;
	background-color: transparent;
	pointer-events: none;
}

.guild-slot-qty {
	display: block;
	position: absolute;
	right: 2dp;
	bottom: 0dp;
	font-size: 11dp;
	font-weight: bold;
	color: #2a4a80;
	pointer-events: none;
}

.guild-logs {
	display: block;
	flex: 1;
	overflow: auto;
}

.guild-log {
	display: block;
	box-sizing: border-box;
	width: 100%;
	min-height: 22dp;
	padding: 2dp 6dp;
	font-size: 12dp;
	font-weight: bold;
	color: #2a4a80;
	border-bottom: 1dp #c8daf0;
}

.guild-log-nav {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex: none;
	height: 28dp;
	margin-top: 2dp;
}

.guild-log-btn,
button.guild-log-btn {
	flex: none;
	width: 64dp;
	height: 26dp;
	line-height: 26dp;
	font-size: 11dp;
}

.guild-log-page {
	display: block;
	width: 36dp;
	height: 26dp;
	line-height: 26dp;
	font-size: 12dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: center;
}

.guild-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: none;
	box-sizing: border-box;
	height: 36dp;
	padding: 4dp 8dp 0dp 8dp;
}

.guild-motto-shell {
	display: block;
	box-sizing: border-box;
	flex: 1;
	height: 28dp;
	margin-right: 6dp;
	padding: 2dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.guild-motto-input,
input.guild-motto-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 24dp;
	line-height: 24dp;
	padding: 0dp 6dp;
	font-family: LatoLatin;
	font-size: 11dp;
	color: #2a4a80;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.guild-footer-btn,
button.guild-footer-btn {
	flex: none;
	width: 80dp;
	height: 28dp;
	line-height: 28dp;
	margin-left: 4dp;
	font-size: 11dp;
}

.guild-footer-hidden,
.guild-footer.guild-footer-hidden {
	display: none;
}

.guild-perm-scrim {
	display: none;
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	z-index: 8;
	background-color: #000000a0;
}

.guild-perm-scrim-open {
	display: block;
}

.guild-perm-modal {
	display: none;
	position: absolute;
	left: 50%;
	top: 50%;
	margin-left: -95dp;
	margin-top: -140dp;
	z-index: 9;
	flex-direction: column;
	width: 190dp;
	min-width: 190dp;
	height: 281dp;
}

.guild-perm-modal-open {
	display: flex;
}

.guild-perm-modal .notice-header {
	flex: none;
	height: 56dp;
	padding: 0dp 8dp;
}

.guild-perm-modal .notice-title {
	padding-top: 16dp;
	font-size: 12dp;
}

.guild-perm-modal .notice-body {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0dp;
	padding: 4dp 8dp 2dp 8dp;
	overflow: hidden;
}

.guild-perm-modal .notice-footer {
	flex: none;
	padding: 4dp 8dp 8dp 8dp;
}

.guild-perm-modal .notice-btn,
.guild-perm-modal button.notice-btn {
	height: 24dp;
	line-height: 24dp;
	font-size: 11dp;
}

.guild-perm-modal .notice-btn-gold,
.guild-perm-modal button.notice-btn-gold {
	margin-right: 6dp;
}

.guild-motto-modal {
	display: none;
	position: absolute;
	left: 50%;
	top: 50%;
	margin-left: -170dp;
	margin-top: -100dp;
	z-index: 9;
	width: 340dp;
}

.guild-motto-modal-open {
	display: block;
}

.guild-motto-modal-shell {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 40dp;
	padding: 2dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.guild-motto-modal-input,
input.guild-motto-modal-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	line-height: 36dp;
	padding: 0dp 12dp;
	font-family: LatoLatin;
	font-size: 14dp;
	color: #2a4a80;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.guild-perm-who {
	display: block;
	flex: none;
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 3dp;
	font-size: 11dp;
	font-weight: bold;
	color: #2a4a80;
	overflow: hidden;
}

.guild-perm-presets {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: none;
	margin-bottom: 4dp;
}

.guild-preset,
button.guild-preset {
	display: block;
	width: 54dp;
	height: 18dp;
	line-height: 18dp;
	margin: 0dp 4dp 3dp 0dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 9dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.guild-perm-list {
	display: block;
	flex: 1;
	min-height: 0dp;
	overflow: auto;
}

.guild-perm,
button.guild-perm {
	display: block;
	width: 100%;
	height: 16dp;
	line-height: 16dp;
	margin-bottom: 2dp;
	padding: 0dp 6dp;
	font-family: LatoLatin;
	font-size: 10dp;
	font-weight: bold;
	text-align: left;
	color: #d45a5a;
	background-color: #f0e4e4;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.guild-perm-on,
button.guild-perm-on {
	color: #2a8048;
	background-color: #d8f0e0;
}
