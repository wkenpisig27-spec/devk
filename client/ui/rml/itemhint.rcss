/* Notice item hint card — floating overlay, never captures mouse. */

body.ih-body-doc {
	position: relative;
	width: 100%;
	height: 100%;
	justify-content: flex-start;
	align-items: flex-start;
	padding: 0dp;
	pointer-events: none;
	font-family: LatoLatin;
	z-index: 80;
}

.ih-card {
	position: absolute;
	display: none;
	flex-direction: column;
	left: 0dp;
	top: 0dp;
	width: 256dp;
	min-width: 256dp;
	margin: 0dp;
	padding: 0dp 0dp 12dp 0dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	pointer-events: none;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
}

.ih-card-open {
	display: flex;
}

.ih-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	position: relative;
	box-sizing: border-box;
	width: 256dp;
	height: 56dp;
	padding: 0dp 16dp 0dp 18dp;
	overflow: visible;
	pointer-events: none;
}

.ih-header-main {
	display: block;
	flex: 1;
	width: 190dp;
	padding-right: 8dp;
	pointer-events: none;
}

.ih-name {
	display: block;
	width: 190dp;
	font-size: 16dp;
	font-weight: bold;
	line-height: 20dp;
	color: #ffffff;
}

.ih-type-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 190dp;
	margin-top: 2dp;
	pointer-events: none;
}

.ih-type {
	display: block;
	flex: none;
	margin-right: 6dp;
	font-size: 12dp;
	line-height: 16dp;
	color: #dce8fa;
}

.ih-badge {
	display: block;
	flex: none;
	height: 16dp;
	line-height: 16dp;
	margin-right: 4dp;
	padding: 0dp 8dp;
	font-size: 10dp;
	font-weight: bold;
	color: #ffffff;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_blue_l.tga,
		ui/rml/frames/notice/capsule_blue_c.tga,
		ui/rml/frames/notice/capsule_blue_r.tga
	);
}

.ih-badge-gold {
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_gold_l.tga,
		ui/rml/frames/notice/capsule_gold_c.tga,
		ui/rml/frames/notice/capsule_gold_r.tga
	);
}

.ih-badge-hidden {
	display: none;
}

.ih-header-side {
	display: flex;
	flex-direction: column;
	flex: none;
	align-items: flex-end;
	justify-content: center;
	width: 52dp;
	pointer-events: none;
}

.ih-icon-well {
	display: block;
	position: relative;
	flex: none;
	box-sizing: border-box;
	width: 48dp;
	height: 48dp;
	padding: 0dp;
	overflow: visible;
	background-color: transparent;
}

.ih-icon {
	display: block;
	width: 48dp;
	height: 48dp;
	background-color: transparent;
	pointer-events: none;
}

.ih-icon-mask {
	display: block;
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 48dp;
	height: 48dp;
	background-color: transparent;
	pointer-events: none;
	decorator: image(ui/rml/frames/notice/ih_icon_mask.tga);
}

.ih-lock {
	display: block;
	position: absolute;
	right: -2dp;
	top: -2dp;
	z-index: 2;
	width: 14dp;
	height: 14dp;
	background-color: transparent;
}

.ih-gem-dots {
	display: flex;
	flex-direction: row;
	margin-top: 3dp;
	pointer-events: none;
}

.ih-gem-dot {
	display: block;
	flex: none;
	width: 8dp;
	height: 8dp;
	margin-left: 3dp;
	background-color: #c5b0e8;
}

.ih-gem-dot-empty {
	background-color: #9eb8e8;
}

.ih-body {
	display: block;
	box-sizing: border-box;
	width: 256dp;
	padding: 8dp 18dp 4dp 18dp;
	pointer-events: none;
}

.ih-meta {
	display: block;
	width: 244dp;
	margin-bottom: 8dp;
	font-size: 13dp;
	font-weight: bold;
	line-height: 18dp;
	color: #2a4a80;
}

.ih-stats {
	display: block;
	width: 244dp;
	pointer-events: none;
}

.ih-stat {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 244dp;
	margin-bottom: 4dp;
	font-size: 14dp;
	line-height: 20dp;
	color: #2a4a80;
}

.ih-stat-star {
	display: block;
	flex: none;
	width: 14dp;
	height: 14dp;
	margin-top: 3dp;
	margin-right: 6dp;
	background-color: transparent;
	pointer-events: none;
	decorator: image(ui/rml/frames/notice/ih_stat_star.tga);
}

.ih-stat-text {
	display: block;
	flex: 1;
	width: 224dp;
	font-size: 14dp;
	line-height: 20dp;
}

.ih-stat-ok {
	color: #1a8a38;
}

.ih-stat-bad {
	color: #c44040;
}

.ih-stat-adv {
	color: #3d7ec8;
}

.ih-section {
	display: block;
	width: 244dp;
	margin-top: 8dp;
	pointer-events: none;
}

.ih-section-hidden {
	display: none;
}

.ih-rule {
	display: block;
	width: 244dp;
	height: 1dp;
	margin-bottom: 8dp;
	background-color: #c5d4ee;
}

.ih-rule-flags {
	margin-top: 10dp;
	margin-bottom: 8dp;
}

.ih-section-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 244dp;
	margin-bottom: 6dp;
	pointer-events: none;
}

.ih-section-head .ih-stat-star {
	margin-top: 0dp;
}

.ih-section-title {
	display: block;
	flex: 1;
	width: 224dp;
	font-size: 13dp;
	font-weight: bold;
	line-height: 18dp;
	color: #2a4a80;
}

.ih-gems {
	display: block;
	width: 244dp;
	pointer-events: none;
}

.ih-gem {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 244dp;
	margin-bottom: 6dp;
	pointer-events: none;
}

.ih-gem-icon-well {
	display: block;
	flex: none;
	box-sizing: border-box;
	width: 36dp;
	height: 36dp;
	padding: 2dp;
	margin-right: 8dp;
	overflow: visible;
	background-color: transparent;
	decorator: image(ui/rml/frames/notice/ih_icon_disc_light.tga);
}

.ih-gem-icon {
	display: block;
	width: 32dp;
	height: 32dp;
	background-color: transparent;
}

.ih-gem-text {
	display: block;
	flex: 1;
	width: 200dp;
	pointer-events: none;
}

.ih-gem-name {
	display: block;
	width: 200dp;
	font-size: 13dp;
	font-weight: bold;
	line-height: 17dp;
	color: #2a4a80;
}

.ih-gem-bonus {
	display: block;
	width: 200dp;
	font-size: 13dp;
	line-height: 17dp;
	color: #3d7ec8;
}

.ih-gem-empty {
	color: #5a7ab0;
}

.ih-special {
	display: block;
	box-sizing: border-box;
	width: 244dp;
	padding: 8dp 10dp;
	font-size: 14dp;
	line-height: 20dp;
	color: #8a4a18;
	background-color: #fff4e4;
}

.ih-flags {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: center;
	width: 244dp;
	pointer-events: none;
}

.ih-flag {
	display: block;
	flex: none;
	height: 16dp;
	line-height: 16dp;
	margin-right: 3dp;
	margin-bottom: 0dp;
	padding: 0dp 5dp;
	font-size: 10dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_blue_l.tga,
		ui/rml/frames/notice/capsule_blue_c.tga,
		ui/rml/frames/notice/capsule_blue_r.tga
	);
}

.ih-flag:last-child {
	margin-right: 0dp;
}

.ih-flag-on {
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_green_l.tga,
		ui/rml/frames/notice/capsule_green_c.tga,
		ui/rml/frames/notice/capsule_green_r.tga
	);
}

.ih-flag-off {
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_red_l.tga,
		ui/rml/frames/notice/capsule_red_c.tga,
		ui/rml/frames/notice/capsule_red_r.tga
	);
}

.ih-flag-stack {
	decorator: tiled-horizontal(
		ui/rml/frames/notice/capsule_blue_l.tga,
		ui/rml/frames/notice/capsule_blue_c.tga,
		ui/rml/frames/notice/capsule_blue_r.tga
	);
}

.ih-value {
	display: block;
	width: 244dp;
	margin-top: 6dp;
	font-size: 13dp;
	font-weight: bold;
	line-height: 18dp;
	color: #5a7ab0;
}

.ih-section-hidden {
	display: none;
}
