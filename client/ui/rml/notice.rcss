/* Shared Notice dialog chrome — crisp soft-AA TGA skins only (no CSS border-radius on shells).
   overflow:visible keeps equal corner AA; never clip Notice shells. */

body {
	position: relative;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	pointer-events: none;
	font-family: LatoLatin;
	color: #3a63a5;
}

#notice-scrim {
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	z-index: 0;
	background-color: #000000a0;
	pointer-events: none;
}

.notice {
	position: relative;
	z-index: 1;
	display: block;
	box-sizing: border-box;
	width: 420dp;
	margin: 0dp;
	padding: 0dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
	pointer-events: auto;
}

.notice-wide {
	width: 460dp;
}

.notice-header {
	display: block;
	position: relative;
	box-sizing: border-box;
	height: 56dp;
	padding: 0dp 28dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.notice-title {
	display: block;
	padding-top: 16dp;
	font-size: 20dp;
	font-weight: bold;
	color: #ffffff;
	text-align: center;
}

.notice-body {
	display: block;
	box-sizing: border-box;
	padding: 16dp 28dp 4dp 28dp;
	background-color: transparent;
}

.notice-label {
	display: block;
	margin-bottom: 8dp;
	font-size: 13dp;
	color: #5a7ab0;
}

.notice-list-shell {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 220dp;
	padding: 6dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.notice-list {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 208dp;
	padding: 4dp;
	overflow: auto;
	background-color: transparent;
}

.notice-list-item,
button.notice-list-item {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	margin-bottom: 4dp;
	padding: 0dp 12dp;
	line-height: 36dp;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: left;
	color: #2a4a80;
	background-color: #e8f0fa;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	transition: background-color 0.12s, color 0.12s;
}

.notice-list-item:hover,
button.notice-list-item:hover {
	background-color: #d4e4f8;
	color: #1a3a70;
}

.notice-list-item-active,
button.notice-list-item-active,
.notice-list-item-active:hover,
button.notice-list-item-active:hover {
	background-color: #5a96dc;
	color: #ffffff;
}

.notice-footer {
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	padding: 10dp 28dp 4dp 28dp;
	background-color: transparent;
}

.notice-btn,
button.notice-btn {
	display: block;
	box-sizing: border-box;
	flex: 1;
	width: auto;
	height: 46dp;
	line-height: 46dp;
	padding: 0dp;
	overflow: visible;
	font-family: LatoLatin;
	font-size: 15dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	/* Prefer image-color over opacity — opacity dirties soft-AA corner fringes. */
	image-color: #ffffff;
}

.notice-btn:hover,
button.notice-btn:hover {
	image-color: #f0f4fa;
}

.notice-btn:active,
button.notice-btn:active {
	image-color: #d8e4f4;
}

.notice-btn-gold,
button.notice-btn-gold {
	margin-right: 12dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_gold_l.tga,
		ui/rml/frames/notice/btn_gold_c.tga,
		ui/rml/frames/notice/btn_gold_r.tga
	);
}

.notice-btn-blue,
button.notice-btn-blue {
	margin-right: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.notice-btn-solo,
button.notice-btn-solo {
	flex: none;
	width: 160dp;
	margin-left: auto;
	margin-right: auto;
}

.notice-exit-row {
	display: flex;
	flex-direction: row;
	justify-content: center;
	box-sizing: border-box;
	padding: 6dp 28dp 16dp 28dp;
	background-color: transparent;
}

/* Secondary pill — same blue skin as Login, slightly smaller */
.notice-exit,
button.notice-exit {
	display: block;
	box-sizing: border-box;
	width: 160dp;
	height: 40dp;
	line-height: 40dp;
	padding: 0dp;
	overflow: visible;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	image-color: #ffffff;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.notice-exit:hover,
button.notice-exit:hover {
	image-color: #f0f4fa;
	color: #ffffff;
}

.notice-exit:active,
button.notice-exit:active {
	image-color: #d8e4f4;
}
