/* Notice-inspired in-game inventory — split Character + Backpack + right tabs. */

body.inv-body {
	justify-content: flex-start;
	align-items: flex-start;
	padding: 0dp;
}

.inv-root {
	position: absolute;
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	/* Tall enough for 8 bag rows without scrolling (scroll was shifting the grid on hover/click). */
	height: 556dp;
	/* Capture clicks in gaps between panels so they don't reach the world. */
	pointer-events: auto;
}

.inv-panel {
	display: block;
	box-sizing: border-box;
	height: 100%;
	margin-right: 10dp;
	padding: 0dp;
	overflow: hidden;
	clip: always;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
	pointer-events: auto;
}

.inv-character {
	flex: none;
	width: 340dp;
	min-width: 340dp;
}

.inv-backpack {
	position: relative;
	flex: none;
	width: 360dp;
	min-width: 360dp;
	margin-right: 8dp;
}

.inv-panel-header {
	display: block;
	position: relative;
	z-index: 2;
	box-sizing: border-box;
	/* Must clear baked blue band in panel_t* (~52px) — same as .notice-header */
	height: 56dp;
	padding: 0dp 16dp;
	background-color: transparent;
}

.inv-drag-handle {
	display: block;
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	z-index: 1;
	padding: 0dp 16dp;
	box-sizing: border-box;
	cursor: move;
}

.inv-panel-title {
	display: block;
	padding-top: 16dp;
	font-size: 18dp;
	font-weight: bold;
	color: #ffffff;
	text-align: left;
}

.inv-mode-tabs {
	display: flex;
	flex-direction: row;
	position: absolute;
	right: 12dp;
	top: 14dp;
	z-index: 3;
}

.inv-mode,
button.inv-mode {
	flex: none;
	width: 78dp;
	height: 28dp;
	line-height: 28dp;
	margin-left: 4dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 11dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	drag: block;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
	image-color: #b8d0ee;
}

.inv-mode-active,
button.inv-mode-active {
	image-color: #ffffff;
}

.inv-close,
button.inv-close {
	display: block;
	position: absolute;
	z-index: 3;
	top: 12dp;
	right: 12dp;
	width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0dp;
	drag: block;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.inv-character-body {
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	height: 280dp;
	padding: 4dp 12dp 0dp 12dp;
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-equip-col {
	display: block;
	flex: none;
	width: 52dp;
	height: 100%;
	padding-top: 8dp;
	overflow: hidden;
	clip: always;
}

.inv-preview-well {
	display: block;
	flex: 1;
	margin: 8dp 8dp 0dp 8dp;
	box-sizing: border-box;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.inv-preview-label {
	display: block;
	padding-top: 120dp;
	font-size: 13dp;
	color: #5a7ab0;
	text-align: center;
}

.inv-equip-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
	align-content: flex-start;
	box-sizing: border-box;
	height: 112dp;
	padding: 6dp 12dp 0dp 12dp;
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-slot {
	display: block;
	position: relative;
	box-sizing: border-box;
	flex: none;
	width: 44dp;
	height: 44dp;
	min-width: 44dp;
	min-height: 44dp;
	max-width: 44dp;
	max-height: 44dp;
	margin: 0dp 4dp 4dp 0dp;
	padding: 2dp;
	overflow: hidden;
	/* Same fill for empty + filled — avoids white/grey mismatch */
	background-color: #e0ecf8;
	border-top-width: 1dp;
	border-right-width: 1dp;
	border-bottom-width: 1dp;
	border-left-width: 1dp;
	border-color: #9eb8e8;
	border-radius: 0dp;
}

.inv-equip-col .inv-slot {
	display: block;
	margin: 0dp 0dp 6dp 0dp;
}

.inv-equip-row .inv-slot {
	display: block;
	margin: 0dp 4dp 4dp 0dp;
}

.inv-slot-icon {
	display: block;
	width: 38dp;
	height: 38dp;
	background-color: transparent;
	pointer-events: none;
}

.inv-slot-placeholder {
	display: block;
	width: 38dp;
	height: 38dp;
	background-color: transparent;
	pointer-events: none;
}

.inv-slot-icon:drag,
.inv-slot:drag {
	/* clone ghost under cursor */
	cursor: move;
}

.inv-slot-qty {
	display: block;
	position: absolute;
	right: 2dp;
	bottom: 1dp;
	font-size: 10dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: right;
}

.inv-slot-empty {
	background-color: #e0ecf8;
}

.inv-slot-locked {
	background-color: #c8d4e4;
}

.inv-currency-row {
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	padding: 4dp 14dp 12dp 14dp;
}

.inv-currency {
	display: block;
	flex: 1;
	margin-right: 8dp;
	padding: 4dp 8dp;
	box-sizing: border-box;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.inv-currency-label {
	display: block;
	font-size: 10dp;
	color: #5a7ab0;
}

.inv-currency-value {
	display: block;
	font-size: 13dp;
	font-weight: bold;
	color: #2a4a80;
}

.inv-backpack-body {
	display: block;
	box-sizing: border-box;
	width: 336dp;
	/* 8 rows * 48dp + 7 gaps * 4dp + top pad */
	height: 420dp;
	margin-top: 8dp;
	margin-left: 12dp;
	margin-right: 12dp;
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-bag-grid {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	padding: 4dp 0dp 0dp 0dp;
	/* No scroll — scrolling made the grid jump when hovering/clicking top/bottom. */
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-bag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: flex-start;
	box-sizing: border-box;
	width: 324dp;
	height: 48dp;
	margin-bottom: 4dp;
}

.inv-bag-row .inv-slot {
	display: block;
	flex: none;
	width: 44dp;
	height: 44dp;
	margin: 0dp 6dp 0dp 0dp;
}

.inv-backpack-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	padding: 6dp 12dp 14dp 12dp;
}

.inv-capacity {
	display: block;
	flex: 1;
	font-size: 12dp;
	color: #5a7ab0;
}

.inv-footer-icon,
button.inv-footer-icon {
	flex: none;
	width: 40dp;
	height: 40dp;
	line-height: 40dp;
	margin-right: 6dp;
	padding: 0dp;
	font-size: 1dp;
	color: #ffffff00;
	text-align: center;
	background-color: transparent;
	drag: block;
}

.inv-footer-icon-last,
button.inv-footer-icon-last {
	margin-right: 0dp;
}

.inv-footer-icon-img {
	display: block;
	width: 22dp;
	height: 22dp;
	margin: 9dp auto 0dp auto;
	background-color: transparent;
	pointer-events: none;
}

.inv-tabs {
	display: block;
	flex: none;
	width: 110dp;
	height: 100%;
	pointer-events: auto;
	padding-top: 56dp;
}

/* Inactive: solid muted pill (no opacity on soft-AA TGA — that causes white corners). */
.inv-tab,
button.inv-tab {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	line-height: 36dp;
	margin-bottom: 6dp;
	padding: 0dp 8dp;
	font-family: LatoLatin;
	font-size: 12dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
	image-color: #b8d0ee;
}

.inv-tab-active,
button.inv-tab-active,
.inv-tab-active:hover,
button.inv-tab-active:hover {
	color: #ffffff;
	image-color: #ffffff;
}

.inv-tab:hover,
button.inv-tab:hover {
	color: #ffffff;
	image-color: #d0e2f8;
}
