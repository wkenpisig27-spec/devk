/* Notice-inspired in-game inventory — split Character + Backpack + right tabs. */

body.inv-body {
	position: relative;
	width: 100%;
	height: 100%;
	justify-content: flex-start;
	align-items: flex-start;
	padding: 0dp;
	/* Inventory chrome captures clicks; modals cover the full document. */
	pointer-events: none;
}

body.inv-body .inv-root,
body.inv-body .inv-modal-open {
	pointer-events: auto;
}

.inv-root {
	position: absolute;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	box-sizing: border-box;
	/* Tall enough for 8 bag rows (44 slot + 4 gap) without scroll jitter. */
	height: 560dp;
	/* Capture clicks in gaps between panels so they don't reach the world. */
	pointer-events: auto;
}

.inv-panel {
	display: block;
	box-sizing: border-box;
	height: 100%;
	/* Equal air between Character | Backpack | tabs */
	margin-right: 8dp;
	padding: 0dp;
	overflow: hidden;
	clip: always;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
	pointer-events: auto;
}

.inv-character {
	display: flex;
	flex-direction: column;
	flex: none;
	/* Match backpack outer width for parallel panel edges. */
	width: 332dp;
	min-width: 332dp;
}

.inv-backpack {
	display: flex;
	flex-direction: column;
	position: relative;
	flex: none;
	/* 12 pad + 284 grid + 6 gap + 10 scroll + 12 pad = 324; +8 chrome = 332 */
	width: 332dp;
	min-width: 332dp;
	margin-right: 8dp;
}

.inv-panel-header {
	display: block;
	position: relative;
	z-index: 2;
	box-sizing: border-box;
	/* Must clear baked blue band in panel_t* (~52px) — same as .notice-header */
	height: 56dp;
	padding: 0dp 16dp;
	background-color: transparent;
}

.inv-drag-handle {
	display: block;
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	z-index: 1;
	padding: 0dp 16dp;
	box-sizing: border-box;
	cursor: move;
}

.inv-panel-title {
	display: block;
	padding-top: 16dp;
	font-size: 18dp;
	font-weight: bold;
	color: #ffffff;
	text-align: left;
}

.inv-mode-tabs {
	display: flex;
	flex-direction: row;
	position: absolute;
	right: 12dp;
	top: 14dp;
	z-index: 3;
}

.inv-mode,
button.inv-mode {
	flex: none;
	width: 78dp;
	height: 28dp;
	line-height: 28dp;
	margin-left: 4dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 11dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	drag: block;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
	image-color: #b8d0ee;
}

.inv-mode-active,
button.inv-mode-active {
	image-color: #ffffff;
}

.inv-close,
button.inv-close {
	display: block;
	position: absolute;
	z-index: 3;
	top: 12dp;
	right: 12dp;
	width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0dp;
	drag: block;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.inv-character-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	box-sizing: border-box;
	height: 336dp;
	/* Same 12dp side inset as backpack body */
	padding: 8dp 12dp 0dp 12dp;
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-equip-col {
	display: block;
	flex: none;
	/* 44 slot + 0 side pad — vertical stack uses 4dp gaps */
	width: 44dp;
	height: 100%;
	padding-top: 0dp;
	overflow: hidden;
	clip: always;
}

.inv-preview-well {
	display: block;
	position: relative;
	flex: 1;
	/* 4dp gutters match slot gap so columns + preview share one rhythm */
	margin: 0dp 8dp 0dp 8dp;
	box-sizing: border-box;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
	drag: block;
}

.inv-preview-rot,
button.inv-preview-rot {
	display: block;
	position: absolute;
	z-index: 2;
	left: 6dp;
	bottom: 6dp;
	width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	drag: block;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.inv-preview-rot-right,
button.inv-preview-rot-right {
	left: auto;
	right: 6dp;
}

.inv-equip-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: none;
	justify-content: center;
	align-content: flex-start;
	box-sizing: border-box;
	/* 2 rows of 44 + one 4dp gap + pads */
	height: 108dp;
	padding: 8dp 12dp 0dp 12dp;
	overflow: hidden;
	clip: always;
	drag: block;
}

.inv-slot {
	display: block;
	position: relative;
	box-sizing: border-box;
	flex: none;
	width: 44dp;
	height: 44dp;
	min-width: 44dp;
	min-height: 44dp;
	max-width: 44dp;
	max-height: 44dp;
	/* Uniform 4dp grid gutters (last cell clears right margin in code). */
	margin: 0dp 4dp 4dp 0dp;
	padding: 4dp;
	overflow: hidden;
	/* Soft-AA rounded slot @ 1:1 with TGA (DX9 — no CSS border-radius). */
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: image(ui/rml/frames/notice/slot_rounded.tga);
	/* Slots manage their own drag via inline property; never inherit block. */
	drag: none;
	focus: none;
	pointer-events: auto;
}

/* Multi-select / active — gold rim baked into TGA. */
.inv-slot-selected {
	decorator: image(ui/rml/frames/notice/slot_rounded_sel.tga);
}

/* Notice context menu (replaces legacy CMenu popup) */
.inv-ctx-root {
	display: none;
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	z-index: 40;
	pointer-events: none;
}

.inv-ctx-open {
	display: block;
	pointer-events: auto;
}

.inv-ctx-scrim {
	display: block;
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	background-color: #00000000;
	pointer-events: auto;
}

.inv-ctx-panel {
	display: block;
	position: absolute;
	box-sizing: border-box;
	min-width: 168dp;
	padding: 8dp 6dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
	pointer-events: auto;
	z-index: 41;
}

.inv-ctx-item {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 28dp;
	margin: 0dp 0dp 2dp 0dp;
	padding: 0dp 14dp;
	font-family: LatoLatin;
	font-size: 13dp;
	font-weight: bold;
	line-height: 28dp;
	color: #2a4a80;
	text-align: left;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	cursor: pointer;
}

.inv-ctx-item:hover {
	color: #ffffff;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.inv-ctx-item-last {
	margin-bottom: 0dp;
}

.inv-equip-col .inv-slot {
	display: block;
	margin: 0dp 0dp 4dp 0dp;
}

.inv-equip-row .inv-slot {
	display: block;
	margin: 0dp 4dp 4dp 0dp;
}

.inv-slot-icon {
	display: block;
	width: 36dp;
	height: 36dp;
	background-color: transparent;
	pointer-events: none;
}

/* Exhausted fairy (Constitution 0): modulate icon — avoid opacity on soft-AA art. */
.inv-slot-icon-dim {
	image-color: #8a96a8;
}

.inv-slot-placeholder {
	display: block;
	width: 36dp;
	height: 36dp;
	background-color: transparent;
	pointer-events: none;
}

.inv-slot-icon:drag,
.inv-slot:drag {
	/* clone ghost under cursor */
	cursor: move;
}

.inv-slot-qty {
	display: block;
	position: absolute;
	right: 2dp;
	bottom: 1dp;
	font-size: 10dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: right;
}

.inv-slot-empty {
	decorator: image(ui/rml/frames/notice/slot_rounded.tga);
}

.inv-slot-locked {
	decorator: image(ui/rml/frames/notice/slot_rounded_locked.tga);
}

.inv-currency-row {
	display: flex;
	flex-direction: row;
	flex: none;
	align-items: stretch;
	box-sizing: border-box;
	/* Match backpack footer vertical rhythm (8 / 10). */
	height: 50dp;
	padding: 8dp 12dp 10dp 12dp;
}

.inv-currency {
	display: block;
	flex: 1;
	margin-right: 8dp;
	padding: 2dp 8dp;
	box-sizing: border-box;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.inv-currency-last {
	margin-right: 0dp;
}

.inv-currency-label {
	display: block;
	font-size: 10dp;
	line-height: 12dp;
	color: #5a7ab0;
}

.inv-currency-value {
	display: block;
	font-size: 13dp;
	line-height: 16dp;
	font-weight: bold;
	color: #2a4a80;
}

.inv-backpack-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	box-sizing: border-box;
	/* 284 grid + 6 + 10 scroll track */
	width: 300dp;
	/* Visible window: 8 rows * 44 + 7 gutters * 4 = 380 */
	height: 380dp;
	margin-top: 8dp;
	margin-left: 12dp;
	margin-right: 12dp;
	overflow: hidden;
	clip: always;
	/* none (not block): drag:block on ancestors breaks RmlUi item drag:clone on slots. */
	drag: none;
}

.inv-bag-grid {
	display: block;
	flex: none;
	box-sizing: border-box;
	/* 6*44 + 5*4 = 284 */
	width: 284dp;
	height: 100%;
	padding: 0dp;
	/* Hidden (not auto): keeps item drag/dblclick stable; wheel + custom bar scroll instead. */
	overflow: hidden;
	clip: always;
	drag: none;
}

.inv-bag-scrollbar {
	display: none;
	position: relative;
	flex: none;
	width: 10dp;
	height: 100%;
	margin-left: 6dp;
	box-sizing: border-box;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	/* Flat continuous track — no rounded end-cap tiles. */
	decorator: tiled-vertical(
		ui/rml/frames/notice/scroll_track_t.tga,
		ui/rml/frames/notice/scroll_track_c.tga,
		ui/rml/frames/notice/scroll_track_b.tga
	);
	drag: block;
}

.inv-bag-scrollbar-visible {
	display: block;
}

.inv-bag-scroll-thumb {
	display: block;
	position: absolute;
	left: 1dp;
	top: 0dp;
	width: 8dp;
	height: 56dp;
	box-sizing: border-box;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-vertical(
		ui/rml/frames/notice/scroll_thumb_t.tga,
		ui/rml/frames/notice/scroll_thumb_c.tga,
		ui/rml/frames/notice/scroll_thumb_b.tga
	);
	drag: block;
}

.inv-bag-scroll-thumb:hover {
	image-color: #c8e4ff;
}

.inv-bag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: flex-start;
	justify-content: flex-start;
	box-sizing: border-box;
	/* Exact: 6*44 + 5*4 */
	width: 284dp;
	height: 44dp;
	margin-bottom: 4dp;
}

.inv-bag-row .inv-slot {
	display: block;
	flex: none;
	width: 44dp;
	height: 44dp;
	/* Code clears margin on the last column for a flush right edge. */
	margin: 0dp 4dp 0dp 0dp;
}

.inv-backpack-footer {
	display: flex;
	flex-direction: row;
	flex: none;
	align-items: center;
	box-sizing: border-box;
	height: 50dp;
	padding: 8dp 12dp 10dp 12dp;
}

.inv-capacity-wrap {
	display: flex;
	flex-direction: row;
	flex: 1;
	align-items: center;
	margin-right: 8dp;
}

.inv-capacity-label {
	display: block;
	flex: none;
	margin-right: 8dp;
	font-size: 13dp;
	font-weight: bold;
	color: #5a7ab0;
}

.inv-capacity-group {
	display: flex;
	flex-direction: row;
	flex: none;
	align-items: center;
}

.inv-capacity-pill {
	display: flex;
	flex-direction: row;
	flex: none;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-width: 96dp;
	height: 32dp;
	padding: 0dp 16dp 0dp 14dp;
	/* Tuck under the add button so they read as one control. */
	margin-right: -8dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/cap_pill_l.tga,
		ui/rml/frames/notice/cap_pill_c.tga,
		ui/rml/frames/notice/cap_pill_r.tga
	);
}

.inv-capacity-used {
	display: block;
	flex: none;
	font-size: 14dp;
	font-weight: bold;
	color: #4a9af0;
	line-height: 32dp;
}

.inv-capacity-sep {
	display: block;
	flex: none;
	margin: 0dp 2dp;
	font-size: 14dp;
	font-weight: bold;
	color: #5a7ab0;
	line-height: 32dp;
}

.inv-capacity-max {
	display: block;
	flex: none;
	font-size: 14dp;
	font-weight: bold;
	color: #5a7ab0;
	line-height: 32dp;
}

.inv-capacity-add,
button.inv-capacity-add {
	display: block;
	position: relative;
	z-index: 2;
	flex: none;
	width: 36dp;
	height: 36dp;
	line-height: 36dp;
	margin: 0dp;
	padding: 0dp;
	font-size: 1dp;
	color: #ffffff00;
	text-align: center;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: image(ui/rml/frames/notice/btn_add_slot.tga);
	drag: block;
}

.inv-capacity-add:hover,
button.inv-capacity-add:hover {
	image-color: #d8ecff;
}

.inv-capacity-add-icon {
	display: block;
	width: 18dp;
	height: 18dp;
	margin: 9dp auto 0dp auto;
	background-color: transparent;
	pointer-events: none;
}

.inv-footer-icon,
button.inv-footer-icon {
	flex: none;
	width: 40dp;
	height: 40dp;
	line-height: 40dp;
	margin-right: 6dp;
	padding: 0dp;
	font-size: 1dp;
	color: #ffffff00;
	text-align: center;
	background-color: transparent;
	drag: block;
}

.inv-footer-icon-last,
button.inv-footer-icon-last {
	margin-right: 0dp;
}

.inv-footer-icon-img {
	display: block;
	width: 22dp;
	height: 22dp;
	margin: 9dp auto 0dp auto;
	background-color: transparent;
	pointer-events: none;
}

.inv-tabs {
	display: block;
	flex: none;
	width: 110dp;
	height: 100%;
	pointer-events: auto;
	padding-top: 56dp;
}

/* Inactive: solid muted pill (no opacity on soft-AA TGA — that causes white corners). */
.inv-tab,
button.inv-tab {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	line-height: 36dp;
	margin-bottom: 6dp;
	padding: 0dp 8dp;
	font-family: LatoLatin;
	font-size: 12dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
	image-color: #b8d0ee;
}

.inv-tab-active,
button.inv-tab-active,
.inv-tab-active:hover,
button.inv-tab-active:hover {
	color: #ffffff;
	image-color: #ffffff;
}

.inv-tab:hover,
button.inv-tab:hover {
	color: #ffffff;
	image-color: #d0e2f8;
}

/* Full-screen Notice confirm overlays (lock / bag slots). */
.inv-modal {
	display: none;
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	z-index: 40;
	pointer-events: none;
}

.inv-modal-open {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	pointer-events: auto;
}

.inv-modal-scrim {
	display: block;
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	z-index: 0;
	background-color: #000000a0;
	pointer-events: auto;
}

.inv-modal-panel {
	position: relative;
	z-index: 1;
	width: 380dp;
	margin: 0dp;
	pointer-events: auto;
}

.inv-modal-panel-expand {
	width: 400dp;
}

.inv-modal-msg {
	display: block;
	margin-bottom: 8dp;
	font-size: 15dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: center;
}

.inv-modal-hint {
	display: block;
	margin-bottom: 12dp;
	font-size: 12dp;
	color: #5a7ab0;
	text-align: center;
}

.inv-expand-slots {
	display: flex;
	flex-direction: row;
	justify-content: center;
	box-sizing: border-box;
	margin: 4dp 0dp 10dp 0dp;
	padding: 8dp 6dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.inv-expand-slot {
	display: block;
	flex: none;
	width: 40dp;
	height: 40dp;
	margin: 0dp 4dp;
	box-sizing: border-box;
	background-color: #e0ecf8;
	border-top-width: 1dp;
	border-right-width: 1dp;
	border-bottom-width: 1dp;
	border-left-width: 1dp;
	border-color: #9eb8e8;
	border-radius: 0dp;
}

.inv-expand-cost {
	display: block;
	margin-bottom: 4dp;
	font-size: 13dp;
	font-weight: bold;
	color: #2a4a80;
	text-align: center;
}
