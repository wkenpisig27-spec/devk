body {
	font-family: rmlui-debugger-font;
	font-size: 18dp;
	color: #ffffff;
	pointer-events: none;
}

#panel {
	pointer-events: auto;
	position: absolute;
	left: 40dp;
	top: 120dp;
	width: 360dp;
	padding: 20dp 22dp;
	background-color: #0a3d8ff0;
	border: 3dp #ffd24a;
}

h1 {
	font-family: rmlui-debugger-font;
	font-size: 28dp;
	font-weight: bold;
	color: #ffd24a;
	margin: 0dp 0dp 12dp 0dp;
}

p {
	font-family: rmlui-debugger-font;
	margin: 0dp 0dp 8dp 0dp;
	line-height: 1.35;
	color: #ffffff;
}

p.hint {
	color: #cfe3ff;
	font-size: 14dp;
	margin-top: 10dp;
	margin-bottom: 0dp;
}
