/* Soft-AA Notice login — curves from TGA skins only (no CSS border-radius on chrome). */

body {
	position: relative;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	pointer-events: none;
	font-family: LatoLatin;
	color: #3a63a5;
}

#notice-scrim {
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	z-index: 0;
	background-color: #000000a0;
	pointer-events: none;
}

.notice {
	position: relative;
	z-index: 1;
	display: block;
	box-sizing: border-box;
	width: 420dp;
	margin: 0dp;
	/* No padding — header blue is baked into panel top 9-slice tiles */
	padding: 0dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/panel_tl.tga,
		ui/rml/frames/notice/panel_t.tga,
		ui/rml/frames/notice/panel_tr.tga,
		ui/rml/frames/notice/panel_l.tga,
		ui/rml/frames/notice/panel_c.tga,
		ui/rml/frames/notice/panel_r.tga,
		ui/rml/frames/notice/panel_bl.tga,
		ui/rml/frames/notice/panel_b.tga,
		ui/rml/frames/notice/panel_br.tga
	);
	pointer-events: auto;
}

/* Layout-only — chrome/rings come from panel top tiles (no second soft layer) */
.notice-header {
	display: block;
	position: relative;
	box-sizing: border-box;
	/* Matches baked panel top-tile height (~border + header band) */
	height: 56dp;
	padding: 0dp 28dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.notice-title {
	display: block;
	padding-top: 16dp;
	font-size: 20dp;
	font-weight: bold;
	color: #ffffff;
	text-align: center;
}

.notice-body {
	display: block;
	box-sizing: border-box;
	padding: 16dp 28dp 4dp 28dp;
	background-color: transparent;
}

.notice-field {
	display: block;
	margin-bottom: 12dp;
}

.notice-label {
	display: block;
	margin-bottom: 5dp;
	font-size: 13dp;
	color: #5a7ab0;
}

/* Soft-AA input shell */
.notice-input-shell {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 40dp;
	padding: 2dp;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.notice-input,
input.notice-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	/* Match height so single-line text is vertically centered */
	line-height: 36dp;
	padding: 0dp 12dp;
	font-family: LatoLatin;
	font-size: 14dp;
	color: #2a4a80;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.notice-check-row {
	display: block;
	height: 22dp;
	margin: 4dp 0dp 6dp 0dp;
}

.notice-check,
input.notice-check {
	display: inline-block;
	vertical-align: middle;
	width: 16dp;
	height: 16dp;
	margin: 0dp 8dp 0dp 0dp;
	padding: 0dp;
	background-color: #ffffff;
	border-top-width: 1dp;
	border-right-width: 1dp;
	border-bottom-width: 1dp;
	border-left-width: 1dp;
	border-top-color: #8aabd8;
	border-right-color: #8aabd8;
	border-bottom-color: #8aabd8;
	border-left-color: #8aabd8;
}

.notice-check:checked,
input.notice-check:checked {
	background-color: #5a96dc;
	border-top-color: #3a78c0;
	border-right-color: #3a78c0;
	border-bottom-color: #3a78c0;
	border-left-color: #3a78c0;
}

.notice-check-row > label {
	display: inline-block;
	vertical-align: middle;
	font-size: 13dp;
	color: #5a7ab0;
}

.notice-footer {
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	padding: 10dp 28dp 4dp 28dp;
	background-color: transparent;
}

.notice-btn,
button.notice-btn {
	display: block;
	box-sizing: border-box;
	flex: 1;
	width: auto;
	height: 46dp;
	/* Match height so label sits on the vertical center */
	line-height: 46dp;
	padding: 0dp;
	font-family: LatoLatin;
	font-size: 15dp;
	font-weight: bold;
	text-align: center;
	color: #ffffff;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	transition: opacity 0.12s;
}

.notice-btn:hover,
button.notice-btn:hover {
	opacity: 0.94;
}

.notice-btn:active,
button.notice-btn:active {
	opacity: 0.82;
}

.notice-btn-gold,
button.notice-btn-gold {
	margin-right: 12dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_gold_l.tga,
		ui/rml/frames/notice/btn_gold_c.tga,
		ui/rml/frames/notice/btn_gold_r.tga
	);
}

.notice-btn-blue,
button.notice-btn-blue {
	margin-right: 0dp;
	decorator: tiled-horizontal(
		ui/rml/frames/notice/btn_blue_l.tga,
		ui/rml/frames/notice/btn_blue_c.tga,
		ui/rml/frames/notice/btn_blue_r.tga
	);
}

.notice-exit-row {
	display: block;
	padding: 0dp 28dp 14dp 28dp;
	background-color: transparent;
	text-align: center;
}

.notice-exit,
button.notice-exit {
	display: inline-block;
	height: 28dp;
	padding: 4dp 16dp;
	font-family: LatoLatin;
	font-size: 13dp;
	color: #7a96c0;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
}

.notice-exit:hover,
button.notice-exit:hover {
	color: #3a63a5;
}
