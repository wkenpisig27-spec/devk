/* Account-only Notice controls (shared chrome in notice.rcss). */

.notice-field {
	display: block;
	margin-bottom: 12dp;
}

.notice-label {
	display: block;
	margin-bottom: 5dp;
	font-size: 13dp;
	color: #5a7ab0;
}

.notice-input-shell {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 40dp;
	padding: 2dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: tiled-box(
		ui/rml/frames/notice/input_tl.tga,
		ui/rml/frames/notice/input_t.tga,
		ui/rml/frames/notice/input_tr.tga,
		ui/rml/frames/notice/input_l.tga,
		ui/rml/frames/notice/input_c.tga,
		ui/rml/frames/notice/input_r.tga,
		ui/rml/frames/notice/input_bl.tga,
		ui/rml/frames/notice/input_b.tga,
		ui/rml/frames/notice/input_br.tga
	);
}

.notice-input,
input.notice-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 36dp;
	line-height: 36dp;
	padding: 0dp 12dp;
	font-family: LatoLatin;
	font-size: 14dp;
	color: #2a4a80;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
}

.notice-check-row {
	display: block;
	height: 22dp;
	margin: 4dp 0dp 6dp 0dp;
}

.notice-check,
input.notice-check {
	display: inline-block;
	vertical-align: middle;
	width: 18dp;
	height: 18dp;
	margin: 0dp 8dp 0dp 0dp;
	padding: 0dp;
	overflow: visible;
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	border-radius: 0dp;
	decorator: image(ui/rml/frames/notice/check_off.tga);
}

.notice-check:checked,
input.notice-check:checked {
	background-color: transparent;
	border-top-width: 0dp;
	border-right-width: 0dp;
	border-bottom-width: 0dp;
	border-left-width: 0dp;
	decorator: image(ui/rml/frames/notice/check_on.tga);
}

.notice-check-row > label {
	display: inline-block;
	vertical-align: middle;
	font-size: 13dp;
	color: #5a7ab0;
}
